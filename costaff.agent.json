{
  "name": "business-analysis-agent",
  "description": "接收任意數據，自動選擇圖表類型、生成視覺化、撰寫分析敘事，產出 PDF 報告或投影片。",
  "version": "0.1.0",
  "a2a_service": {
    "port": 8081,
    "health_path": "/.well-known/agent.json"
  },
  "public_port": 18101,
  "env_required": ["GOOGLE_API_KEY"],
  "env_optional": [
    "BUSINESS_ANALYSIS_AGENT_MODEL",
    "COSTAFF_AGENT_MODEL_PROVIDER",
    "LITELLM_MODEL_NAME",
    "LITELLM_API_BASE",
    "LITELLM_API_KEY",
    "BUSINESS_ANALYSIS_AGENT_MCP_URLS"
  ],
  "mcp_configurable": true,
  "mcp_env_var": "BUSINESS_ANALYSIS_AGENT_MCP_URLS"
}
